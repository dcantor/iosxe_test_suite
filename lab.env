# ---- Hub-and-spoke C8000V testbed ----------------------------------------
#
#     h2 --[R2 spoke]== ESP ==\                /== ESP ==[R3 spoke]-- h3
#                              \              /
#                               [R1 HUB]-- h1
#
# R1 is the hub and owns a tunnel to each spoke. Spokes peer only with the hub;
# spoke-to-spoke traffic is decrypted and re-encrypted at R1, so it is encrypted
# on both legs. Every QEMU link is a socket netdev with the hub/LAN side
# listening, so routers start before spokes and hosts.

ROUTERS="R1 R2 R3"
HOSTS="H1 H2 H3"
HUB=R1
SPOKES="R2 R3"

VM_CPUS=4
VM_RAM_MB=8192
VM_USER=lab
VM_PASS=Lab_123!
LICENSE_LEVEL=network-premier
LICENSE_ADDON=dna-premier

IPSEC_PSK=LabPreSharedKey123
BGP_PASSWORD=LabBgpSecret
BGP_KEEPALIVE=10
BGP_HOLDTIME=30
# BFD detects a dead peer far faster than the BGP hold time can. Timers are
# deliberately unaggressive: these are virtual routers sharing a host CPU, and
# sub-second detection on a contended hypervisor produces false positives.
# 500ms x 3 gives 1.5s detection against a 30s hold time.
BFD_INTERVAL=500
BFD_MIN_RX=500
BFD_MULTIPLIER=3
# Filtering controls *what* a peer may send; maximum-prefix controls *how
# much*. Normal load is 3 prefixes at the hub and 6 at a spoke, so 15 leaves
# headroom while still tripping long before a peer could exhaust memory.
BGP_MAX_PREFIX=15
BGP_MAX_PREFIX_WARN=80
# ESP-AES-256 with SHA256 over a 1500-byte path leaves 1438 for the payload.
# Asserted rather than derived: if the transform changes, the overhead changes
# and someone should be made to notice.
PHYSICAL_MTU=1500
TUNNEL_MTU=1438
# Each advertised prefix is tagged <origin ASN>:<class>, so a community names
# both where a prefix came from and what kind of prefix it is. Nine valid
# communities exist in this topology (3 routers x 3 classes); anything else is
# rejected inbound.
COMMUNITY_LOOPBACK_ID=1
COMMUNITY_NAT_ID=2
COMMUNITY_LAN_ID=3
LINK_MASK=255.255.255.252
TUNNEL_MASK=255.255.255.252
LAN_MASK=255.255.255.0
MCAST_LOCALADDR=127.0.0.1

# ---- out-of-band management network ---------------------------------------
# A flat /24 every router and the NMS attach to, carrying NTP, syslog and SNMP.
# It is a multicast segment like the LANs, so all four machines share one wire.
# Management therefore no longer rides the data path: it does not cross the
# IPsec tunnels, and a spoke is reachable even with its tunnel down.
# The OOB interface sits in its own VRF, so management is isolated by the
# routing table rather than only by topology: a leak from the global table
# into management (or the reverse) becomes impossible rather than unlikely.
MGMT_VRF=MGMT
# ---- TACACS+ -------------------------------------------------------------
# The server runs on the NMS and is reached over the OOB network, so AAA rides
# the management VRF like everything else. Two remote users with different
# privilege levels, to prove the level really comes from the server.
TACACS_KEY=LabTacacsKey123
TACACS_SERVER_NAME=LAB-TAC
TACACS_GROUP=LABTACGRP
TACACS_PORT=49
TACACS_ADMIN_USER=netadmin
TACACS_ADMIN_PASS=NetAdmin_123!
TACACS_ADMIN_PRIV=15
TACACS_OPS_USER=netops
TACACS_OPS_PASS=NetOps_123!
TACACS_OPS_PRIV=1
TACACS_ACCT_LOG=/var/log/tac_plus.acct
TACACS_LOG=/var/log/tac_plus.log

# ---- VTY access control ---------------------------------------------------
# Management logins are restricted to the out-of-band network. The second entry
# is the hypervisor's user-mode NAT: every tool in this repo reaches the routers
# through a forwarded port on Gi1, so sessions arrive from 10.0.2.2 and not from
# the OOB subnet at all. Without it the ACL locks the test harness out of the
# whole lab, with the serial console as the only way back. It is this lab's
# equivalent of console access, and it does weaken the control -- a real
# deployment would have no such path, or would reach the devices through the NMS
# as a jump host so that sessions genuinely originate on the management network.
# The pre-login banner lives in its own file so the routers and the tests read
# the same source; a copy in either place would drift.
BANNER_FILE=config/login-banner.txt
BANNER_DELIM=^
VTY_ACL=VTY-MGMT
MGMT_NAT_NET=10.0.2.0
MGMT_NAT_WILDCARD=0.0.0.255
OOB_NET=192.168.99.0
OOB_MASK=255.255.255.0
OOB_PREFIX=24
OOB_MCAST=230.10.99.1
OOB_PORT=10099
R1_OOB_IP=192.168.99.1
R2_OOB_IP=192.168.99.2
R3_OOB_IP=192.168.99.3
NMS_OOB_IP=192.168.99.10
# the OOB NIC is added last, so its interface number depends on how many the
# role already has: the hub has four, a spoke three
R1_OOB_INTF=GigabitEthernet5
R2_OOB_INTF=GigabitEthernet4
R3_OOB_INTF=GigabitEthernet4
LAN_PREFIX=24

# ---- R1 : hub -------------------------------------------------------------
R1_NAME=c8000v-r1
R1_ROLE=hub
R1_ASN=65001
R1_SSH=2221
R1_NETCONF=8831
R1_RESTCONF=8441
R1_CONSOLE=5001
R1_LOOPBACK=172.16.1.1
R1_BGP_PREFIX=10.20.1.1
R1_LAN_IP=192.168.10.1
R1_LAN_NET=192.168.10.0
R1_LAN_PORT=10002
# LAN segments are QEMU multicast netdevs, not point-to-point sockets, so more
# than two machines can share one. localaddr pins them to lo: no lab traffic
# reaches the physical network.
R1_LAN_MCAST=230.10.10.1

# ---- R2 : spoke, on the hub's Gi2 ----------------------------------------
R2_NAME=c8000v-r2
R2_ROLE=spoke
R2_ASN=65002
R2_SSH=2222
R2_NETCONF=8832
R2_RESTCONF=8442
R2_CONSOLE=5002
R2_LOOPBACK=172.16.2.1
R2_BGP_PREFIX=10.20.2.1
R2_LAN_IP=192.168.20.1
R2_LAN_NET=192.168.20.0
R2_LAN_PORT=10003
R2_LAN_MCAST=230.10.20.1
R2_LINK_PORT=10001
R2_HUB_INTF=GigabitEthernet2
R2_LINK_HUB=10.10.10.1
R2_LINK_LOCAL=10.10.10.2
R2_TUNNEL_HUB=192.168.100.1
R2_TUNNEL_LOCAL=192.168.100.2
R2_HUB_TUNNEL_ID=0

# ---- R3 : spoke, on the hub's Gi4 ----------------------------------------
R3_NAME=c8000v-r3
R3_ROLE=spoke
R3_ASN=65003
R3_SSH=2223
R3_NETCONF=8833
R3_RESTCONF=8443
R3_CONSOLE=5003
R3_LOOPBACK=172.16.3.1
R3_BGP_PREFIX=10.20.3.1
R3_LAN_IP=192.168.30.1
R3_LAN_NET=192.168.30.0
R3_LAN_PORT=10005
R3_LAN_MCAST=230.10.30.1
R3_LINK_PORT=10004
R3_HUB_INTF=GigabitEthernet4
R3_LINK_HUB=10.10.20.1
R3_LINK_LOCAL=10.10.20.2
R3_TUNNEL_HUB=192.168.101.1
R3_TUNNEL_LOCAL=192.168.101.2
R3_HUB_TUNNEL_ID=1

# ---- Linux hosts ----------------------------------------------------------
HOST_IMAGE=cirros-0.6.2-x86_64-disk.img
HOST_CPUS=1
HOST_RAM_MB=256
HOST_USER=cirros
HOST_PASS=gocubsgo

H1_NAME=h1
H1_ROUTER=R1
H1_IP=192.168.10.10
H1_SSH=2231
H1_CONSOLE=5011

H2_NAME=h2
H2_ROUTER=R2
H2_IP=192.168.20.10
H2_SSH=2232
H2_CONSOLE=5012

H3_NAME=h3
H3_ROUTER=R3
H3_IP=192.168.30.10
H3_SSH=2233
H3_CONSOLE=5013

# ---- Source NAT ------------------------------------------------------------
# Each router statically source-NATs its own host into a per-site /24 inside a
# shared NAT domain. A route-map limits translation to traffic destined for that
# domain, so the original LAN-to-LAN path keeps working untranslated -- without
# it, both ends would rewrite their source and replies would arrive from an
# address the sender never contacted.
NAT_DOMAIN=10.30.0.0
NAT_DOMAIN_WILDCARD=0.0.255.255
NAT_DOMAIN_PREFIX=16
R1_NAT_NET=10.30.1.0
R2_NAT_NET=10.30.2.0
R3_NAT_NET=10.30.3.0
H1_NAT_IP=10.30.1.10
H2_NAT_IP=10.30.2.10
H3_NAT_IP=10.30.3.10

# ---- Multiple host addresses: static 1:1 alongside a dynamic pool ----------
# Per host, addresses are laid out in two clean blocks:
#   .10 - .19   10 addresses, each with its own static one-to-one mapping
#   .64 - .93   30 addresses, translated from a per-site pool
# The dynamic block sits on a /27 boundary so the pool ACL is one line rather
# than thirty. The pool holds exactly 30 addresses and the rule has no
# "overload", so 30 inside addresses consume the pool exactly -- which makes
# one-to-one allocation observable, and exhaustion testable.
NAT_STATIC_COUNT=10
NAT_DYNAMIC_COUNT=30
STATIC_HOST_OFFSET=10
STATIC_MAP_OFFSET=10
DYNAMIC_HOST_OFFSET=64
DYNAMIC_HOST_WILDCARD=0.0.0.31
POOL_OFFSET=100

# ---- NTP ------------------------------------------------------------------
# The routers reach the internet through their management NIC's QEMU user-mode
# NAT, whose built-in resolver is 10.0.2.3. NTP is sourced from that interface
# so the request leaves by the only path that has a route out.
DNS_SERVER=10.0.2.3
NTP_SOURCE_INTF=GigabitEthernet1
NTP_SERVERS="0.pool.ntp.org 1.pool.ntp.org 2.pool.ntp.org"

# ---- Syslog ---------------------------------------------------------------
# h1 doubles as the syslog collector. All three routers log to it: the spokes'
# messages reach it across the IPsec tunnels, since the LAN prefixes are carried
# by BGP. Each router sources from its own LAN interface so the sender is
# identifiable, and that traffic does not match the NAT rules (which only
# translate host addresses toward the NAT domain).
# Both collectors run on the NMS, not on h1: it has real daemons (rsyslog,
# snmptrapd) which accept every sender on one socket, so the per-router port
# workaround that busybox nc forced is gone.
SYSLOG_HOST=192.168.10.20
# busybox nc connects its UDP socket to the first sender and then ignores every
# other source, so one listener cannot serve three routers. Each router gets its
# own port and its own collector instance.
SYSLOG_PORT=514
SYSLOG_DIR=/var/log/lab
SYSLOG_TRAP_LEVEL=informational

# ---- SNMPv3 ---------------------------------------------------------------
# Traps go to the same host as syslog. As with syslog, each router needs its own
# UDP port: the busybox collector binds to its first sender and drops the rest.
SNMP_USER=labmon
SNMP_GROUP=LABGRP
SNMP_VIEW=LABVIEW
SNMP_AUTH_PASS=LabAuthPass123
SNMP_PRIV_PASS=LabPrivPass123
SNMP_TRAP_PORT=162
# A second destination carrying the same traps, captured raw so the tests can
# still prove the payloads are encrypted on the wire -- snmptrapd decrypts them,
# so its log cannot show that. Both listeners run at once on the NMS.
SNMP_TRAP_RAW_PORT=1162
SNMP_TRAPD_LOG=/var/log/lab/snmptrapd.log

# ---- NMS: a real Linux VM with net-snmp, for SNMPv3 polling ----------------
# Sits on the hub's LAN alongside h1, so it reaches R1 directly and the spokes
# across the tunnels on the LAN prefixes BGP already carries. Unlike the cirros
# hosts this one has a package manager, so it can run snmpwalk/snmpget.
NMS_NAME=nms
NMS_IMAGE=ubuntu-24.04-minimal-cloudimg-amd64.img
NMS_CPUS=1
NMS_RAM_MB=1024
NMS_USER=lab
NMS_PASS=Lab_123!
NMS_IP=192.168.10.20
NMS_SSH=2241
NMS_CONSOLE=5021
NMS_ROUTER=R1
